@page "/tools/knowledgebase/new"
@page "/tools/knowledgebase/article/{ArticleId:int}"
@using GlpiNg.Modules.Abstractions.Directory
@using GlpiNg.Modules.Abstractions.Documents
@using GlpiNg.Modules.Abstractions.Notes
@rendermode InteractiveServer

<PageTitle>@(_article?.Subject ?? "Article") — GlpiNg</PageTitle>

@if (_notFound)
{
    <div class="text-center text-secondary py-5">
        <i class="ti ti-book-off fs-1"></i>
        <p class="mt-2">Cet article est introuvable, ou n'est pas visible avec vos habilitations.</p>
        <a href="/tools/knowledgebase" class="btn btn-primary"><i class="ti ti-arrow-left me-1"></i>Retour à la base de connaissances</a>
    </div>
}
else if (_article is not null)
{
    <div class="glpi-fiche-topbar">
        <a class="glpi-fiche-pager-btn" href="/tools/knowledgebase" title="Retour à la liste">
            <i class="ti ti-list"></i>
        </a>
        <div class="glpi-fiche-crumb">
            <i class="ti ti-book"></i>
            <span>@(IsNew ? "Nouvel article" : $"Article - {_article.Subject}")</span>
        </div>
        <div class="glpi-fiche-toolbar">
            @if (_editMode)
            {
                <button type="button" class="btn btn-sm" disabled="@_isSaving" @onclick="CancelEdit">Annuler</button>
                <button type="button" class="btn btn-sm btn-primary" disabled="@(_isSaving || !CanSave)" @onclick="SaveAsync">
                    <i class="ti ti-device-floppy me-1 @(_isSaving ? "glpi-spin" : "")"></i>Enregistrer
                </button>
            }
            else
            {
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="ti ti-dots-vertical me-1"></i>Actions
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><button type="button" class="dropdown-item" @onclick="EnterEditMode"><i class="ti ti-pencil me-1"></i>Modifier</button></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <button type="button" class="dropdown-item text-danger" @onclick="() => _confirmDelete = true">
                                <i class="ti ti-trash me-1"></i>Supprimer définitivement
                            </button>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>

    @if (_confirmDelete)
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between gap-3" role="alert">
            <div>
                <i class="ti ti-alert-triangle me-1"></i>
                Supprimer cet article, ses révisions et ses cibles ? Cette action est définitive.
            </div>
            <div class="btn-list">
                <button type="button" class="btn btn-sm" @onclick="() => _confirmDelete = false">Annuler</button>
                <button type="button" class="btn btn-sm btn-danger" @onclick="DeleteAsync">Supprimer</button>
            </div>
        </div>
    }

    <div class="glpi-fiche-layout">
        <aside class="glpi-fiche-sidebar">
            @foreach ((string Key, string Icon, string Label, int? Count) tab in Tabs)
            {
                <button type="button" class="glpi-fiche-tab-item @(_activeTab == tab.Key ? "active" : "")" @onclick="() => _activeTab = tab.Key">
                    <i class="ti @tab.Icon"></i>
                    <span>@tab.Label</span>
                    @if (tab.Count is { } count)
                    {
                        <span class="glpi-fiche-tab-count">@count</span>
                    }
                </button>
            }
        </aside>

        <div class="glpi-fiche-panel">
            @switch (_activeTab)
            {
                case "article":
                    @if (_editMode)
                    {
                        <div class="glpi-fiche-form">
                            <div class="mb-3">
                                <label class="form-label" for="kb-subject">Sujet</label>
                                <input id="kb-subject" class="form-control" @bind="_article.Subject" @bind:event="oninput" placeholder="Question ou titre de l'article" />
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="kb-category">Catégorie</label>
                                    <select id="kb-category" class="form-select" value="@(_article.CategoryId?.ToString() ?? string.Empty)"
                                            @onchange="@((ChangeEventArgs e) => SetCategory((string?)e.Value))">
                                        <option value="">Sans catégorie</option>
                                        @foreach ((KnowledgeBaseCategory category, int depth) in _categoryTree)
                                        {
                                            @* Espace insécable : un navigateur réduit les espaces ordinaires d'une <option>, l'indentation de l'arbre disparaîtrait. *@
                                            <option value="@category.Id">@(new string('\u00A0', depth * 4))@category.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <label class="d-flex align-items-center gap-2 mb-2">
                                        <input class="form-check-input m-0" type="checkbox" @bind="_article.IsFaq" />
                                        <span>Publier dans la FAQ</span>
                                    </label>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <label class="d-flex align-items-center gap-2 mb-2">
                                        <input class="form-check-input m-0" type="checkbox" @bind="_article.IsPinned" />
                                        <span>Épingler</span>
                                    </label>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-3">
                                    <label class="form-label" for="kb-visible-from">Visible à partir du</label>
                                    <input id="kb-visible-from" class="form-control" type="date" value="@DateValue(_article.VisibleFrom)"
                                           @onchange="@((ChangeEventArgs e) => _article.VisibleFrom = ParseDate((string?)e.Value))" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label" for="kb-visible-until">Visible jusqu'au</label>
                                    <input id="kb-visible-until" class="form-control" type="date" value="@DateValue(_article.VisibleUntil)"
                                           @onchange="@((ChangeEventArgs e) => _article.VisibleUntil = ParseDate((string?)e.Value))" />
                                </div>
                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="text-secondary small mb-2">
                                        Bornes facultatives. Hors de cette période, l'article n'est visible que de son auteur —
                                        il n'est pas supprimé.
                                    </div>
                                </div>
                            </div>

                            <label class="form-label" for="@ContentEditorId">Contenu</label>

                            <div class="glpi-md-editor">
                                <div class="glpi-md-editor-bar">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Mise en forme">
                                        @foreach (EditorCommand command in EditorCommands)
                                        {
                                            @if (command.IsSeparator)
                                            {
                                                <span class="glpi-md-editor-sep"></span>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-icon" title="@command.Label" disabled="@_editorPreview"
                                                        @onclick="() => ApplyCommandAsync(command)">
                                                    <i class="ti @command.Icon"></i>
                                                </button>
                                            }
                                        }
                                    </div>

                                    <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="Affichage">
                                        <button type="button" class="btn @(_editorPreview ? "" : "active")" @onclick="() => _editorPreview = false">
                                            <i class="ti ti-pencil me-1"></i>Rédaction
                                        </button>
                                        <button type="button" class="btn @(_editorPreview ? "active" : "")" @onclick="() => _editorPreview = true">
                                            <i class="ti ti-eye me-1"></i>Aperçu
                                        </button>
                                    </div>
                                </div>

                                @* Le textarea reste monté en aperçu (caché) : le démonter ferait perdre la
                                   position du curseur et la pile d'annulation du navigateur à chaque bascule. *@
                                <textarea id="@ContentEditorId" class="form-control glpi-md-editor-input @(_editorPreview ? "d-none" : "")"
                                          rows="18" @bind="_article.Content" @bind:event="oninput"
                                          placeholder="Réponse, procédure, contournement... (Markdown accepté)"></textarea>

                                @if (_editorPreview)
                                {
                                    <div class="glpi-md-editor-preview glpi-kb-content">
                                        @if (string.IsNullOrWhiteSpace(_article.Content))
                                        {
                                            <span class="text-secondary">Rien à prévisualiser pour l'instant.</span>
                                        }
                                        else
                                        {
                                            @((MarkupString)MarkdownRenderer.ToHtml(_article.Content))
                                        }
                                    </div>
                                }
                            </div>

                            <div class="text-secondary small mt-1">
                                Markdown : <code>**gras**</code>, <code>*italique*</code>, <code>## titre</code>,
                                <code>- liste</code>, <code>[lien](url)</code>, <code>`code`</code>, tableaux.
                                Le HTML écrit dans le contenu n'est pas interprété : il s'affiche tel quel.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <h2 class="mb-0">@_article.Subject</h2>
                            @if (_article.IsFaq)
                            {
                                <span class="badge bg-green-lt">FAQ</span>
                            }
                            @if (_article.IsPinned)
                            {
                                <span class="badge bg-secondary-lt"><i class="ti ti-pin me-1"></i>Épinglé</span>
                            }
                            @* Seul l'auteur peut voir un article hors période : le lui signaler évite
                               qu'il croie publié ce que personne d'autre ne voit. *@
                            @if (!KnowledgeBaseService.IsPublished(_article, DateTime.UtcNow))
                            {
                                <span class="badge bg-orange-lt"><i class="ti ti-clock-off me-1"></i>Hors période de visibilité</span>
                            }
                        </div>

                        <div class="text-secondary small mb-3">
                            <i class="ti ti-folder me-1"></i>@(_article.Category?.Name ?? "Sans catégorie")
                            <span class="ms-3"><i class="ti ti-user me-1"></i>@(_article.AuthorName ?? "Inconnu")</span>
                            <span class="ms-3"><i class="ti ti-calendar-plus me-1"></i>Créé le @_article.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            @if (_article.UpdatedAt is { } updatedAt)
                            {
                                <span class="ms-3">
                                    <i class="ti ti-pencil me-1"></i>Modifié le @updatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    @if (_article.LastEditorName is { Length: > 0 } editor)
                                    {
                                        <text> par @editor</text>
                                    }
                                </span>
                            }
                            <span class="ms-3"><i class="ti ti-eye me-1"></i>@_article.ViewCount consultation@(_article.ViewCount > 1 ? "s" : "")</span>
                            @if (_article.VisibleFrom is { } visibleFrom)
                            {
                                <span class="ms-3"><i class="ti ti-calendar-up me-1"></i>Visible depuis le @visibleFrom.ToString("dd/MM/yyyy")</span>
                            }
                            @if (_article.VisibleUntil is { } visibleUntil)
                            {
                                <span class="ms-3"><i class="ti ti-calendar-down me-1"></i>Visible jusqu'au @visibleUntil.ToString("dd/MM/yyyy")</span>
                            }
                        </div>

                        <div class="glpi-kb-content">@((MarkupString)MarkdownRenderer.ToHtml(_article.Content))</div>
                    }
                    break;

                case "targets":
                    <p class="text-secondary">
                        Sans aucune cible, l'article est visible de tous ceux qui accèdent à la base de connaissances,
                        dans les limites du cloisonnement par entité. Dès qu'une cible est ajoutée, seuls les acteurs
                        visés — et l'auteur — y ont accès.
                    </p>
                    <p class="text-secondary">
                        Une cible groupe ou profil peut être restreinte à une entité, et s'étendre ou non à ses
                        sous-entités : sans cette portée, cibler un profil ouvrirait l'article à ce profil dans
                        toutes les entités à la fois.
                    </p>

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-auto">
                            <label class="form-label" for="kb-target-kind">Type de cible</label>
                            <select id="kb-target-kind" class="form-select" value="@_newTargetKind"
                                    @onchange="@((ChangeEventArgs e) => SetTargetKindAsync((string?)e.Value))">
                                <option value="@nameof(PrincipalKind.Entity)">Entité</option>
                                <option value="@nameof(PrincipalKind.Group)">Groupe</option>
                                <option value="@nameof(PrincipalKind.Profile)">Profil</option>
                                <option value="@nameof(PrincipalKind.User)">Utilisateur</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <label class="form-label" for="kb-target-item">Cible</label>
                            <select id="kb-target-item" class="form-select" style="min-width: 16rem;" value="@_newTargetItemId"
                                    @onchange="@((ChangeEventArgs e) => _newTargetItemId = (string?)e.Value ?? string.Empty)">
                                <option value="">Choisir...</option>
                                @foreach (PrincipalOption option in _targetOptions)
                                {
                                    <option value="@option.Id">@option.Name</option>
                                }
                            </select>
                        </div>
                        @if (ScopeApplies)
                        {
                            <div class="col-auto">
                                <label class="form-label" for="kb-target-scope">Dans l'entité</label>
                                <select id="kb-target-scope" class="form-select" style="min-width: 12rem;" value="@_newTargetScopeEntityId"
                                        @onchange="@((ChangeEventArgs e) => _newTargetScopeEntityId = (string?)e.Value ?? string.Empty)">
                                    <option value="">Toute l'installation</option>
                                    @foreach (PrincipalOption option in _entityOptions)
                                    {
                                        <option value="@option.Id">@option.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (RecursionApplies)
                        {
                            <div class="col-auto">
                                <label class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" checked="@_newTargetRecursive"
                                           @onchange="@((ChangeEventArgs e) => _newTargetRecursive = (bool?)e.Value ?? false)" />
                                    <span class="form-check-label">Et sous-entités</span>
                                </label>
                            </div>
                        }
                        <div class="col-auto">
                            <button type="button" class="btn btn-primary" disabled="@(_newTargetItemId.Length == 0)" @onclick="AddTargetAsync">
                                <i class="ti ti-plus me-1"></i>Ajouter
                            </button>
                        </div>
                    </div>

                    @if (_article.Targets.Count == 0)
                    {
                        <div class="text-secondary">Aucune cible : article visible de tous.</div>
                    }
                    else
                    {
                        <table class="table table-vcenter">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Cible</th>
                                    <th>Portée</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KnowledgeBaseArticleTarget target in _article.Targets)
                                {
                                    <tr>
                                        <td>@KindLabel(target.Type)</td>
                                        <td>@TargetName(target)</td>
                                        <td class="text-secondary">@TargetScopeLabel(target)</td>
                                        <td>
                                            <button type="button" class="btn btn-icon btn-ghost-danger" title="Retirer cette cible"
                                                    @onclick="() => RemoveTargetAsync(target)">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    break;

                case "revisions":
                    @if (_revisions.Count == 0)
                    {
                        <div class="text-secondary">Aucune révision : l'article n'a pas été modifié depuis sa rédaction.</div>
                    }
                    else
                    {
                        <table class="table table-vcenter">
                            <thead>
                                <tr>
                                    <th class="w-1">N°</th>
                                    <th>Archivée le</th>
                                    <th>Par</th>
                                    <th>Sujet d'alors</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KnowledgeBaseArticleRevision revision in _revisions)
                                {
                                    <tr>
                                        <td>@revision.Number</td>
                                        <td>@revision.RevisedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@(revision.EditorName ?? "—")</td>
                                        <td>@revision.Subject</td>
                                        <td class="text-nowrap">
                                            <button type="button" class="btn btn-sm" @onclick="() => ToggleRevision(revision.Id)">
                                                <i class="ti @(_openRevisionId == revision.Id ? "ti-eye-off" : "ti-eye") me-1"></i>
                                                @(_openRevisionId == revision.Id ? "Masquer" : "Voir")
                                            </button>
                                            <button type="button" class="btn btn-sm" @onclick="() => RestoreRevisionAsync(revision)">
                                                <i class="ti ti-history me-1"></i>Restaurer
                                            </button>
                                        </td>
                                    </tr>

                                    @if (_openRevisionId == revision.Id)
                                    {
                                        <tr>
                                            <td colspan="5">
                                                <div class="border rounded p-3 glpi-kb-content">@((MarkupString)MarkdownRenderer.ToHtml(revision.Content))</div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    break;

                case "documents":
                    <p class="text-secondary">
                        Fichiers rattachés à l'article. Un document est une fiche globale, partageable entre
                        plusieurs objets : le détacher d'ici ne le supprime pas de l'installation.
                    </p>

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="form-label" for="kb-doc-upload">Téléverser un fichier</label>
                            <InputFile id="kb-doc-upload" class="form-control" OnChange="UploadDocumentAsync" disabled="@_isUploading" />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label" for="kb-doc-search">Ou rattacher un document existant</label>
                            <div class="input-group">
                                <input id="kb-doc-search" class="form-control" @bind="_documentSearch" @bind:event="oninput"
                                       placeholder="Nom ou nom de fichier" />
                                <button type="button" class="btn" @onclick="SearchDocumentsAsync">
                                    <i class="ti ti-search me-1"></i>Chercher
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (_isUploading)
                    {
                        <div class="text-secondary mb-3"><i class="ti ti-loader me-1"></i>Téléversement en cours…</div>
                    }

                    @if (_uploadError is { Length: > 0 } uploadError)
                    {
                        <div class="alert alert-danger">@uploadError</div>
                    }

                    @if (_documentCandidates.Count > 0)
                    {
                        <div class="border rounded mb-3">
                            <div class="list-group list-group-flush">
                                @foreach (DocumentSummary candidate in _documentCandidates)
                                {
                                    <div class="list-group-item d-flex align-items-center gap-2">
                                        <i class="ti ti-file"></i>
                                        <span class="flex-fill">@candidate.Name <span class="text-secondary small">(@candidate.FileName)</span></span>
                                        <button type="button" class="btn btn-sm" @onclick="() => AttachDocumentAsync(candidate)">
                                            <i class="ti ti-link me-1"></i>Rattacher
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (_documents.Count == 0)
                    {
                        <div class="text-secondary">Aucun document rattaché.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-vcenter">
                                <thead>
                                    <tr>
                                        <th>Nom</th>
                                        <th>Fichier</th>
                                        <th>Taille</th>
                                        <th>Ajouté le</th>
                                        <th class="w-1"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DocumentSummary document in _documents)
                                    {
                                        <tr>
                                            <td>@document.Name</td>
                                            <td class="text-secondary">@document.FileName</td>
                                            <td class="text-secondary text-nowrap">@FormatSize(document.SizeBytes)</td>
                                            <td class="text-secondary text-nowrap">@document.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                            <td class="text-nowrap">
                                                @if (document.IsContentMissing)
                                                {
                                                    @* Fiche importée sans son fichier : le proposer au téléchargement
                                                       ne donnerait qu'une erreur. *@
                                                    <span class="badge bg-orange-lt" title="Fichier absent : importé sans accès au dossier files/ de GLPI">
                                                        <i class="ti ti-file-off me-1"></i>Sans fichier
                                                    </span>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-sm" href="@DocumentUrl(document)" target="_blank" rel="noopener">
                                                        <i class="ti ti-download me-1"></i>Télécharger
                                                    </a>
                                                }
                                                <button type="button" class="btn btn-icon btn-ghost-danger" title="Détacher de cet article"
                                                        @onclick="() => DetachDocumentAsync(document)">
                                                    <i class="ti ti-unlink"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    break;

                case "notes":
                    <p class="text-secondary">
                        Notes libres attachées à l'article. Elles ne font pas partie de son contenu et ne sont
                        pas reprises dans les révisions : c'est le carnet de bord de ceux qui l'entretiennent.
                    </p>

                    <div class="mb-3">
                        <label class="form-label" for="kb-new-note">Ajouter une note</label>
                        <textarea id="kb-new-note" class="form-control" rows="3"
                                  placeholder="Remarque, contexte, rappel…"
                                  @bind="_newNote" @bind:event="oninput"></textarea>
                        <button type="button" class="btn btn-primary mt-2"
                                disabled="@string.IsNullOrWhiteSpace(_newNote)" @onclick="AddNoteAsync">
                            <i class="ti ti-plus me-1"></i>Ajouter
                        </button>
                    </div>

                    @if (_notes.Count == 0)
                    {
                        <div class="text-secondary">Aucune note.</div>
                    }
                    else
                    {
                        @foreach (ItemNote note in _notes)
                        {
                            <div class="card mb-2">
                                <div class="card-body">
                                    @if (_editingNoteId == note.Id)
                                    {
                                        <textarea class="form-control" rows="4"
                                                  @bind="_editingNote" @bind:event="oninput"></textarea>
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-primary btn-sm"
                                                    disabled="@string.IsNullOrWhiteSpace(_editingNote)" @onclick="SaveNoteAsync">
                                                Enregistrer
                                            </button>
                                            <button type="button" class="btn btn-sm" @onclick="CancelEditNote">Annuler</button>
                                        </div>
                                    }
                                    else
                                    {
                                        @* Rendu par le même convertisseur que le contenu de l'article : une note
                                           est du Markdown, et n'interprète donc jamais le HTML qu'on y collerait. *@
                                        <div class="glpi-kb-content">@((MarkupString)MarkdownRenderer.ToHtml(note.Content))</div>

                                        <div class="d-flex align-items-center justify-content-between mt-2">
                                            <div class="text-secondary small">
                                                <i class="ti ti-user me-1"></i>@note.AuthorName
                                                <span class="ms-2">
                                                    <i class="ti ti-calendar me-1"></i>@note.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                                @if (note.UpdatedAt is { } updated)
                                                {
                                                    <span class="ms-2">
                                                        <i class="ti ti-pencil me-1"></i>Modifiée le @updated.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                        @if (note.LastEditorName is { Length: > 0 } editor)
                                                        {
                                                            <text> par @editor</text>
                                                        }
                                                    </span>
                                                }
                                            </div>

                                            <div class="text-nowrap">
                                                <button type="button" class="btn btn-icon btn-sm" title="Modifier"
                                                        @onclick="() => StartEditNote(note)">
                                                    <i class="ti ti-pencil"></i>
                                                </button>
                                                @if (_confirmDeleteNoteId == note.Id)
                                                {
                                                    <button type="button" class="btn btn-sm btn-danger"
                                                            @onclick="() => DeleteNoteAsync(note.Id)">
                                                        Confirmer
                                                    </button>
                                                    <button type="button" class="btn btn-sm"
                                                            @onclick="() => _confirmDeleteNoteId = null">
                                                        Annuler
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-icon btn-sm btn-ghost-danger" title="Supprimer"
                                                            @onclick="() => _confirmDeleteNoteId = note.Id">
                                                        <i class="ti ti-trash"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    break;

                case "history":
                    <p class="text-secondary">
                        Toutes les modifications de l'article : contenu, classement, drapeaux, dates de visibilité
                        et cibles. Les révisions, elles, n'archivent que le texte — pour le restaurer.
                    </p>

                    @if (_historyEntries.Count == 0)
                    {
                        <div class="text-secondary">Aucun historique.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-vcenter">
                                <thead>
                                    <tr>
                                        <th class="w-1">ID</th>
                                        <th>Date</th>
                                        <th>Utilisateur</th>
                                        <th>Champ</th>
                                        <th>Mise à jour</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (KnowledgeBaseArticleHistoryEntry entry in _historyEntries)
                                    {
                                        <tr>
                                            <td>@entry.Id</td>
                                            <td class="text-nowrap">@entry.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@entry.User</td>
                                            <td>@entry.Field</td>
                                            <td>@entry.Description</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    break;
            }
        </div>
    </div>
}
